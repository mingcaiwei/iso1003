<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>以太网启动器</string>
	<key>CFBundleExecutable</key>
	<string>EthernetLauncher</string>
	<key>CFBundleIdentifier</key>
	<string>com.ceshi.ethlauncher</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>EthernetLauncher</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>14.0</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<!-- ================= TrollStore 守护进程 / 开机自启 ================= -->
	<key>SBAppIsDaemon</key>
	<true/>
	<key>LaunchAtBoot</key>
	<true/>
	<key>RestartAfterCrash</key>
	<true/>
	<key>Hide</key>
	<true/>
	<key>Background</key>
	<true/>
	<key>UIApplicationExitsOnSuspend</key>
	<false/>

	<!-- 后台保活：网络鉴权模式，系统不会随手回收 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>network-authentication</string>
		<string>fetch</string>
	</array>

	<!-- 允许被 URL Scheme 唤起（便于手动触发一次检测） -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.ceshi.ethlauncher</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ethlauncher</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
